<?xml version="1.0" encoding="utf-8"?>
<!-- Bloquea tráfico HTTP en texto claro y fuerza HTTPS para máxima seguridad -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
