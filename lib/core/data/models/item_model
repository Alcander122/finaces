class Item {
  final String nombre;
  final double valor;

  Item({required this.nombre, required this.valor});

  Map<String, dynamic> toMap() {
    return {
      'nombre': nombre,
      'valor': valor,
    };
  }

  factory Item.fromMap(Map<String, dynamic> map) {
    return Item(
      nombre: map['nombre'] ?? 'Sin nombre',
      valor: (map['valor'] as num?)?.toDouble() ?? 0.0,
    );
  }
}